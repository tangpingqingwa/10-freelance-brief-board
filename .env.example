# Copy to .env.local. Never commit secrets. The mode must be explicit.
WAFFO_MODE=fixture
DATABASE_PATH=:memory:

# Waffo Pancake MoR (test or production). Never set these in fixture CI.
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRODUCT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_PRIVATE_KEY_FILE=
WAFFO_API_BASE=https://api.waffo.ai
WAFFO_WEBHOOK_TEST_PUBLIC_KEY=
WAFFO_WEBHOOK_PROD_PUBLIC_KEY=
PUBLIC_BASE_URL=http://localhost:3000

# Legacy Polar variables are ignored and never select a provider.
POLAR_LIVE=
POLAR_FIXTURE_ONLY=
